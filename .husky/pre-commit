pnpm test

# Block unconditional .only in test files
# Allows: test.skip(true, "reason") (conditional Playwright skip)
# Blocks: test.only(, describe.only(, it.only(
if grep -rE '\.(only)\(' tests/ e2e/ --include='*.ts' --include='*.spec.ts' 2>/dev/null; then
  echo ""
  echo "ERROR: .only found in test files. Remove before committing."
  exit 1
fi
