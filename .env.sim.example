# Hackathon simulation env (docs/SIM.md)
#
# Copy this file to .env.sim and fill in the SHARED TEST Supabase values.
# .env.sim is gitignored
# Operators: the real values live in the ehl-ops repo (.env.test).
#
#   cp .env.sim.example .env.sim   # then paste the test-DB values below
#
# Every tester uses the SAME values here so they all share one database.

# --- Shared test Supabase (from ehl-ops/.env.test) ---
NEXT_PUBLIC_SUPABASE_URL=https://<test-project-ref>.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=<test-anon-key>
SUPABASE_SERVICE_ROLE_KEY=<test-service-role-key>

# --- Local app ---
NEXT_PUBLIC_SITE_URL=http://localhost:3001

# Enables the no-Google one-click login at /dev-login.
# NEVER set this to true in production.
DEV_LOGIN_ENABLED=true

# Admin allowlist for the seed admin persona (admin@example.com).
ADMIN_EMAIL_DOMAIN=example.com
ADMIN_FALLBACK_EMAILS=admin@example.com

# Cloudflare Turnstile test keys (always pass, never call the network).
NEXT_PUBLIC_TURNSTILE_SITE_KEY=1x00000000000000000000AA
TURNSTILE_SECRET_KEY=1x0000000000000000000000000000000AA

# Marks this as a test target (read by seed/safety scripts).
SUPABASE_TEST_MODE=true

# --- GitHub integration (from ehl-ops/.env.local) ---
# Required to snapshot (fork) participant repos into the snapshot org when an
# admin locks a challenge. Without this, locking still works but the snapshot
# step is skipped and a warning is shown.
GITHUB_TOKEN=<github-pat-for-ehl-gg-bot>
GITHUB_ORG=european-hackathon-league

# --- AI code review (from ehl-ops/.env.local) ---
# Required to run the automated code review pipeline after locking.
# Without this, locking works but no code review report is generated.
OPENROUTER_API_KEY=<openrouter-api-key>
