# Supabase
NEXT_PUBLIC_SUPABASE_URL=https://your-project.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=your-anon-key
SUPABASE_SERVICE_ROLE_KEY=your-service-role-key

# Email (SMTP)
SMTP_HOST=smtp.gmail.com
SMTP_PORT=587
SMTP_USER=your-email@example.com
SMTP_PASSWORD=your-app-password
SMTP_FROM=Your App <noreply@example.com>

# Google Drive (service account)
GOOGLE_DRIVE_CREDENTIALS=base64-encoded-service-account-json
GOOGLE_DRIVE_ROOT_FOLDER_ID=your-folder-id

# GitHub (bot account)
GITHUB_TOKEN=ghp_your-token
GITHUB_ORG=your-snapshot-org
GITHUB_REPO=your-org/your-repo

# Cloudflare Turnstile
NEXT_PUBLIC_TURNSTILE_SITE_KEY=your-site-key
TURNSTILE_SECRET_KEY=your-secret-key

# Upstash Redis (rate limiting) -- auto-set by Vercel Marketplace, run `vercel env pull` to sync
KV_REST_API_URL=
KV_REST_API_TOKEN=

# OpenRouter (AI code reviews)
OPENROUTER_API_KEY=sk-or-v1-your-key

# Site URL
NEXT_PUBLIC_SITE_URL=https://your-domain.com

# Admin domain (emails must end with @this-domain to be admins)
ADMIN_EMAIL_DOMAIN=your-org.com

# Organization branding (used in footer, contact pages)
NEXT_PUBLIC_ORG_NAME=Your Organization
NEXT_PUBLIC_ORG_WEBSITE=https://your-org.com
NEXT_PUBLIC_CONTACT_EMAIL=contact@your-org.com
NEXT_PUBLIC_ORG_LINKEDIN=https://linkedin.com/company/your-org
NEXT_PUBLIC_ORG_INSTAGRAM=your_org_handle

# Optional
# PREVIEW_PASSWORD=your-preview-password
# CRON_SECRET=your-cron-secret
# VERIFICATION_ENCRYPTION_KEY=your-encryption-key
# Secret for signing public certificate links (HMAC capability token).
# Falls back to VERIFICATION_ENCRYPTION_KEY if unset. Set a long random value.
# CERTIFICATE_LINK_SECRET=your-certificate-link-secret
# ADMIN_FALLBACK_EMAILS=admin@example.com
